    },
    "v2": {
      "status_id": "blank/omitted -> literal latest",
      "create_body": {
        "id": "bound tenant ID",
        "displayName": "Operational Hierarchy"
      },
      "get_create_response": "status-bearing opaque result; assigned upload composition does not consume full model",
      "import_response": "string map with required id; projected requestId; missing id is decode/contract failure",
      "create_condition": "GET 404 only; other failed GET stops",
      "failure_after_create": "retain created hierarchy and operation context; no automatic singleton delete or upload replay"
    },
    "async_contract": "Set returns operation identity without polling; Get is a single status read; bounded explicit poll, without borrowing Graph poll interval",
    "response_states": "preserve raw status; optional normalized projection from sourced model; unknown is never success",
    "crud_limits": "no paginated List established; v1 has no standalone Create/Get hierarchy contract; v2 supporting Get/Create do not imply a full hierarchy response schema"
  },
