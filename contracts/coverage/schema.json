{
  "type": "object",
  "required": [
    "schema_version",
    "baseline_version",
    "common_parameters",
    "session_mapping",
    "records"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "baseline_version": {
      "type": "string",
      "const": "8.1.0"
    },
    "common_parameters": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "session_mapping": {
      "type": "string",
      "minLength": 1
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "symbol": {
      "type": "object",
      "required": [
        "file",
        "name"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "parameter_set": {
      "type": "object",
      "required": [
        "name",
        "metadata_ref",
        "symbols",
        "contract_tests",
        "live_tests"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "metadata_ref": {
          "type": "string",
          "minLength": 1
        },
        "symbols": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/symbol"
          }
        },
        "contract_tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/symbol"
          }
        },
        "live_tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/symbol"
          }
        }
      },
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "resource",
        "implementation_owner",
        "research_owner",
        "metadata_ref",
        "parameter_sets",
        "implementation",
        "contract",
        "live",
        "exclusion"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "management",
            "session",
            "local-builder",
            "research-candidate",
            "excluded"
          ]
        },
        "resource": {
          "type": "string",
          "minLength": 1
        },
        "implementation_owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "research_owner": {
          "type": "string",
          "minLength": 1
        },
        "metadata_ref": {
          "type": "string",
          "minLength": 1
        },
        "parameter_sets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter_set"
          }
        },
        "implementation": {
          "type": "object",
          "required": [
            "status",
            "unsupported_stub",
            "symbols"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "not-started",
                "in-progress",
                "implemented",
                "unsupported"
              ]
            },
            "unsupported_stub": {
              "type": "boolean"
            },
            "symbols": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/symbol"
              }
            }
          },
          "additionalProperties": false
        },
        "contract": {
          "type": "object",
          "required": [
            "status",
            "evidence"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "metadata-only",
                "passed",
                "failed"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "live": {
          "type": "object",
          "required": [
            "status",
            "reason",
            "evidence"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "not-run",
                "passed",
                "failed",
                "skipped",
                "unavailable"
              ]
            },
            "reason": {
              "type": "string"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "exclusion": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
